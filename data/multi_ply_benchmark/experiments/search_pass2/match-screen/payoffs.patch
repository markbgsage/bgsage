+MatchPayoffs match_payoffs(int away1, int away2, int cube_value, bool is_crawford) {
+    struct Entry {
+        int away1, away2, cube;
+        bool crawford, valid;
+        MatchPayoffs values;
+    };
+    // A tree visits the same handful of scores at successive cube values.
+    // Keep the full key for collisions and scores outside the standard MET.
+    static thread_local std::array<Entry, 64> cache{};
+    unsigned key = static_cast<unsigned>(away1) * 31 + static_cast<unsigned>(away2) * 7;
+    key = key * 17 + static_cast<unsigned>(cube_value) + is_crawford;
+    auto& e = cache[key % cache.size()];
+    if (!e.valid || e.away1 != away1 || e.away2 != away2 ||
+        e.cube != cube_value || e.crawford != is_crawford) {
+        e = {away1, away2, cube_value, is_crawford, true,
+             {get_met_after(away1, away2, cube_value, true, is_crawford),
+              get_met_after(away1, away2, 2 * cube_value, true, is_crawford),
+              get_met_after(away1, away2, 3 * cube_value, true, is_crawford),
+              get_met_after(away1, away2, cube_value, false, is_crawford),
+              get_met_after(away1, away2, 2 * cube_value, false, is_crawford),
+              get_met_after(away1, away2, 3 * cube_value, false, is_crawford)}};
+    }
+    return e.values;
+}
