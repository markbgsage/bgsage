+std::array<float, NN_OUTPUTS> NeuralNetwork::forward_board_from_base(
+    const Board& board, const Board& base, const float* hidden, const float* inputs) const {
+    const bool race = n_inputs_ == TESAURO_INPUTS;
+    int indices[64];
+    float values[64];
+    const int count = board_input_deltas(board, base, inputs, race, indices, values);
+    if (count == 64) {
+        if (race) return forward(compute_tesauro_inputs(board));
+        return forward(compute_extended_contact_inputs(board).data());
+    }
+    return forward_with_deltas(hidden, indices, values, count);
+}
