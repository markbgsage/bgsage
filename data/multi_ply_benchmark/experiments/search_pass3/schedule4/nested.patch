+    // Nested fan-out waits only for claimed items. A caller can finish all
+    // the work even when every pool thread is running an outer checker task.
+    void roll_for(int n_items, int workers, const std::function<void(int)>& fn) const {
+        struct Job {
+            std::atomic<int> next{0};
+            std::mutex mutex;
+            std::condition_variable done;
+            int completed = 0;
+            std::exception_ptr error;
+        };
+        auto job = std::make_shared<Job>();
+        auto claim = [job, n_items, &fn] {
+            int done = 0;
+            std::exception_ptr error;
+            for (int i = job->next.fetch_add(1, std::memory_order_relaxed); i < n_items;
+                 i = job->next.fetch_add(1, std::memory_order_relaxed)) {
+                try { fn(i); } catch (...) { error = std::current_exception(); }
+                ++done;
+            }
+            if (done) {
+                std::lock_guard lock(job->mutex);
+                if (error) job->error = error;
+                job->completed += done;
+                if (job->completed == n_items) job->done.notify_one();
+            }
+        };
+        for (int t = 1; t < workers; ++t) enqueue(claim);
+        claim();
+        std::unique_lock lock(job->mutex);
+        job->done.wait(lock, [&] { return job->completed == n_items; });
+        if (job->error) std::rethrow_exception(job->error);
+    }
