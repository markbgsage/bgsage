 struct CandidateBatchCache;
 
+struct CheckerSubtrees {
+    struct Value {
+        Board board;
+        std::array<float, 4> equity;
+        std::array<float, NUM_OUTPUTS> probs;
+        uint64_t fingerprint;
+    };
+    struct Shard {
+        std::mutex mutex;
+        std::unordered_map<uint64_t, Value> nodes;
+        unsigned hits = 0, probes = 0;
+    };
+    std::array<Shard, 64> shards;
+    bool get(uint64_t key, uint64_t fp, const Board& board, int cci,
+             float* eq, std::array<float, NUM_OUTPUTS>* probs) {
+        auto& shard = shards[key % shards.size()];
+        std::lock_guard lock(shard.mutex);
+        ++shard.probes;
+        auto it = shard.nodes.find(key);
+        if (it == shard.nodes.end() || it->second.fingerprint != fp || it->second.board != board)
+            return false;
+        ++shard.hits;
+        std::copy_n(it->second.equity.begin(), cci, eq);
+        if (probs) *probs = it->second.probs;
+        return true;
+    }
+    void put(uint64_t key, uint64_t fp, const Board& board, int cci, const float* eq,
+             const std::array<float, NUM_OUTPUTS>& probs) {
+        auto& shard = shards[key % shards.size()];
+        std::lock_guard lock(shard.mutex);
+        if (shard.nodes.size() >= 128) return;
+        auto& v = shard.nodes[key];
+        v.board = board;
+        v.fingerprint = fp;
+        std::copy_n(eq, cci, v.equity.begin());
+        v.probs = probs;
+    }
+};
