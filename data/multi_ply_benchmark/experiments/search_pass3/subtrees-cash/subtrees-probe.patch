+
+std::vector<CubefulProbsAndEquity> evaluate_checker_endpoints(
+    const Board& before, const std::vector<Board>& endpoints, const CubeInfo& cube,
+    const Strategy& strategy, int plies, int threads) {
+    const int count = static_cast<int>(endpoints.size());
+    const int workers = std::clamp(threads, 1, std::max(count, 1));
+    std::vector<CubefulProbsAndEquity> moves(count);
+    std::vector<std::exception_ptr> errors(count);
+    CheckerSubtrees cache;
+    std::atomic<int> next{0};
+    multipy_parallel_run(workers, [&] {
+        for (int i = next.fetch_add(1, std::memory_order_relaxed); i < count;
+             i = next.fetch_add(1, std::memory_order_relaxed)) {
+            try {
+                auto& r = moves[i];
+                cubeful_equity_nply_multi_impl<false>(flip(endpoints[i]), &cube, 1, strategy,
+                    plies, &r.equity, MoveFilters::TINY, count == 1 ? std::min(threads, 21) : 1,
+                    nullptr, false, &r.probs, false, &before, nullptr,
+                    workers > 1 && plies > 2 ? &cache : nullptr);
+            } catch (...) { errors[i] = std::current_exception(); }
+        }
+    });
+    if (std::getenv("BGSAGE_BENCH_CACHE_STATS")) {
+        unsigned hits = 0, probes = 0;
+        for (const auto& s : cache.shards) { hits += s.hits; probes += s.probes; }
+        std::fprintf(stderr, "checker-subtrees %d %d %u %u\n", plies, count, hits, probes);
+    }
+    for (const auto& e : errors) if (e) std::rethrow_exception(e);
+    return moves;
 }
 
