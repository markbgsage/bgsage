+namespace {
+
+struct ScoreOutcomes {
+    float single, gammon, backgammon;
+
+    float conditional(float g, float bg) const {
+        return (1.0f - g - bg) * single + g * gammon + bg * backgammon;
+    }
+};
+
+ScoreOutcomes score_outcomes(int away1, int away2, int64_t cv, bool win, bool craw) {
+    auto after = [&](int multiple) {
+        int points = static_cast<int>(std::min<int64_t>(multiple * cv, INT_MAX));
+        return get_met_after(away1, away2, points, win, craw);
+    };
+    return {after(1), after(2), after(3)};
+}
+
+struct CashLevel {
+    struct Side {
+        ScoreOutcomes wins, losses;
+        float pass;
+    };
+    Side sides[2];
+};
+
+// The score determines the recube ladder and all its MET entries. Only
+// gammon rates, and therefore the interpolation, vary between candidate boards.
+struct MatchCashPlan {
+    int away1 = 0, away2 = 0, value = 0;
+    bool crawford = false;
+    ScoreOutcomes wins{}, losses{};
+    std::vector<CashLevel> levels; // Current cube through the dead cube.
+
+    void prepare(int a1, int a2, int cv, bool craw) {
+        away1 = a1;
+        away2 = a2;
+        value = cv;
+        crawford = craw;
+        wins = score_outcomes(a1, a2, cv, true, craw);
+        losses = score_outcomes(a1, a2, cv, false, craw);
+        levels.clear();
+        for (int64_t cube = cv;; cube *= 2) {
+            auto& level = levels.emplace_back();
+            bool live = a1 > 2 * cube && a2 > 2 * cube;
+            for (int k = 0; k < 2; ++k) {
+                const int d = k == 0 ? a1 : a2, t = k == 0 ? a2 : a1;
+                const bool auto_redouble = d <= 2 * cube && t > 2 * cube;
+                const int64_t stake = (auto_redouble ? 4 : 2) * cube;
+                auto& side = level.sides[k];
+                side.wins = score_outcomes(d, t, stake, true, craw);
+                side.losses = score_outcomes(d, t, stake, false, craw);
+                side.pass = get_met_after(d, t, static_cast<int>(cube), true, craw);
+            }
+            if (!live) break;
+        }
+    }
+
+    float dead_mwc(const std::array<float, NUM_OUTPUTS>& p) const {
+        float mwc = 0.0f;
+        mwc += (p[0] - p[1]) * wins.single;
+        mwc += (p[1] - p[2]) * wins.gammon;
+        mwc += p[2] * wins.backgammon;
+        mwc += ((1.0f - p[0]) - p[3]) * losses.single;
+        mwc += (p[3] - p[4]) * losses.gammon;
+        mwc += p[4] * losses.backgammon;
+        return mwc;
+    }
+
+    void cash_points(float g0, float bg0, float g1, float bg1,
+                     float& player, float& opponent) const {
+        const float g[] = {g0, g1}, bg[] = {bg0, bg1};
+        float cp[2];
+        const auto& last = levels.back();
+        for (int k = 0; k < 2; ++k) {
+            const auto& side = last.sides[k];
+            const float win = side.wins.conditional(g[k], bg[k]);
+            const float loss = side.losses.conditional(g[1-k], bg[1-k]);
+            const float denom = loss - win;
+            cp[k] = std::abs(denom) < 1e-10f ? 0.5f :
+                    std::clamp((loss - side.pass) / denom, 0.0f, 1.0f);
+        }
+        for (int i = static_cast<int>(levels.size()) - 2; i >= 0; --i) {
+            const float above[] = {cp[0], cp[1]};
+            for (int k = 0; k < 2; ++k) {
+                const auto& side = levels[i].sides[k];
+                const float win = side.wins.conditional(g[k], bg[k]);
+                const float denom = side.losses.single - win;
+                cp[k] = std::abs(denom) < 1e-10f ? 0.5f :
+                        std::clamp(1.0f - above[1-k] * (side.pass - win) / denom, 0.0f, 1.0f);
+            }
+        }
+        player = cp[0];
+        opponent = cp[1];
+    }
+};
+
+const MatchCashPlan& match_cash_plan(int a1, int a2, int cv, bool craw) {
+    // Score and cube-state equality are verified on every hit. A collision
+    // simply rebuilds the entry. Independent callers share no mutable state.
+    thread_local std::array<MatchCashPlan, 32> plans;
+    if (cv <= 0) throw std::invalid_argument("Cube value must be positive");
+    unsigned index = 13u * a1 + 7u * a2 + 5u * (cv ^ (cv >> 3)) + craw;
+    auto& plan = plans[index % plans.size()];
+    if (plan.away1 != a1 || plan.away2 != a2 || plan.value != cv || plan.crawford != craw)
+        plan.prepare(a1, a2, cv, craw);
+    return plan;
+}
